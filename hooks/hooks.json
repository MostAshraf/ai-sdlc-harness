{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/run-guard\" bash || ${CLAUDE_PLUGIN_ROOT}/hooks/run-guard bash"
          }
        ]
      },
      {
        "matcher": "Write|WriteFile|write_file|Edit|MultiEdit|NotebookEdit|notebook_edit",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/run-guard\" write || ${CLAUDE_PLUGIN_ROOT}/hooks/run-guard write"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/run-guard\" spawn || ${CLAUDE_PLUGIN_ROOT}/hooks/run-guard spawn"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/run-guard\" skill || ${CLAUDE_PLUGIN_ROOT}/hooks/run-guard skill"
          }
        ]
      },
      {
        "matcher": "Read|ReadFile|read_file|Grep|grep_search",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/run-guard\" read || ${CLAUDE_PLUGIN_ROOT}/hooks/run-guard read"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/run-guard\" user-prompt || ${CLAUDE_PLUGIN_ROOT}/hooks/run-guard user-prompt"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/run-guard\" post-spawn || ${CLAUDE_PLUGIN_ROOT}/hooks/run-guard post-spawn"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/run-guard\" subagent-stop || ${CLAUDE_PLUGIN_ROOT}/hooks/run-guard subagent-stop"
          }
        ]
      }
    ]
  }
}
